@*
-----------------------------------------------------------------------
Section Name : BumonModal (部門一覧)
Description  :
    Bootstrap modal used to display the department list (部門一覧).

    - Opens as a popup modal when the user needs to select a department.
    - The modal body content is loaded dynamically.

Elements :
    bumonModal      : Modal container ID
    bumonModalBody  : Area where department list will be rendered
-----------------------------------------------------------------------
*@
<div class="modal fade"
     id="bumonModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5>

                    部門一覧

                </h5>

                <button class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body"
                 id="bumonModalBody">
            </div>

        </div>

    </div>

</div>