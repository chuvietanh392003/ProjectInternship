@model PlannedTransactionRegistrationVM

@{
    ViewData["Title"] = "予定伝票入力";
}

<partial name="_Message" />

<h2 class="text-center mb-5">
    予定伝票入力
</h2>

<form asp-controller="PlannedTransactionRegistration"
      asp-action="Index"
      method="post"
      id="mainForm">

    @Html.AntiForgeryToken()

    <div class="container">

        <partial name="_HeaderForm"
                 model="Model" />

        <partial name="_DetailTable"
                 model="Model" />

    </div>

</form>

<partial name="_DepartmentModal" />

@section Scripts {

    <script src="~/js/department-modal.js"></script>

    <script src="~/js/planned-transaction-registration.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

                const codeInput = document.getElementById("BumoncdYkanr");
                const nameInput = document.getElementById("BumoncdName");

                if (!codeInput) {
                    return;
                }

                codeInput.addEventListener("input", function () {

                    const code = codeInput.value;

                    if (!code) {
                        nameInput.value = "";
                        return;
                    }

                    fetch('@Url.Action("GetDepartmentName", "PlannedTransactionRegistration")?code=' + code)
                        .then(response => response.json())
                        .then(data => {
                            nameInput.value = data ?? "";
                        })
                        .catch(error => {
                            nameInput.value = "";
                        });
                });

            });
    </script>
}
