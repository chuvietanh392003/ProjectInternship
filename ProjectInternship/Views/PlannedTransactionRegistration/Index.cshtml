@*
-----------------------------------------------------------------------
File Name   : PlannedTransactionRegistration.cshtml
Screen Name : 予定伝票入力 (Planned Transaction Registration)

Description :
    Screen for registering planned transaction.
    Includes:
        - Header information input
        - Detail table for transportation expenses
        - Department selection modal

Controller  : PlannedTransactionRegistrationController
-----------------------------------------------------------------------
*@
@model PlannedTransactionRegistrationVM

@{
    ViewData["Title"] = "予定伝票入力";
}

<partial name="_Message" />

<h2 class="text-center mb-5">
    予定伝票入力
</h2>

@* SearchForm *@

<form asp-controller="PlannedTransactionRegistration"
      asp-action="Index"
      method="post"
      id="mainForm">

    @Html.AntiForgeryToken()

    <div class="container">

        <partial name="_HeaderForm"
                 model="Model" />

        <partial name="_DetailTable"
                 model="Model" />

    </div>

</form>

<partial name="_DepartmentModal" />

@section Scripts {

    <script src="~/js/department-modal.js"></script>

    <script src="~/js/planned-transaction-registration.js"></script>
}
