@*
-----------------------------------------------------------------------
Section Name : DetailTable (明細追加)
Description  :
    Section for adding new detail record to the planned transaction.

    - "明細追加" button navigates to PlannedTransactionDetail screen.
    - Passes the following parameters:
        ・Denpyono : Transaction number
        ・Gyono    : Next detail row number
-----------------------------------------------------------------------
*@

@model PlannedTransactionRegistrationVM

<!-- ===== 明細追加 ===== -->

<div class="row mb-3 align-items-center">

    <label class="col-2 col-form-label">

        （備考）

    </label>

    <div class="col text-end">

        <a class="btn btn-primary"
           asp-controller="PlannedTransactionDetail"
           asp-action="Index"
           asp-route-Denpyono="@Model.Denpyono"
           asp-route-Gyono="@Model.NextGyono">

            明細追加

        </a>

    </div>

</div>





<!-- ===========================
 DETAIL TABLE
=========================== -->

<div class="table-responsive" style="max-height:200px; overflow-y:auto;">
    <table class="table table-hover table-bordered">

        <thead>

            <tr class="table-secondary">

                <th colspan="6" class="text-center">
                    交通費
                </th>

            </tr>

            <tr class="table-secondary text-center">

                <th>行</th>

                <th>年月日</th>

                <th>出発地</th>

                <th>目的地</th>

                <th>経路</th>

                <th>金額</th>
            </tr>

        </thead>



        <tbody id="detailBody" class="text-center">
        </tbody>
        <tfoot>
            <tr>
                <td colspan="4"></td>

                <td class="fw-bold text-end">
                    交通費計
                </td>

                <td id="totalKingaku"
                    class="fw-bold text-center">
                    @(Model?.TotalKingaku?.ToString("N0"))
                </td>
            </tr>
        </tfoot>
    </table>
</div>


<style>
    .detail-row {
        cursor: pointer;
    }

    .table tfoot tr td {
        border: none;
    }

    .table tbody tr.deleted-row> td{
        background-color: darkgray !important;
        color: white !important;
    }

        .detail-row:hover {
            background-color: #f8f9fa;
        }

</style>

<!-- ===========================
 LOAD SERVER → LOCALSTORAGE
=========================== -->
<script>
    const serverDetails = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                        Model.Results ?? new List<PlannedTransactionDetailVM>()
                )
        );
</script>
<script src="~/js/planned-transaction-registration-data-store.js"></script>