@model PlannedTransactionRegistrationVM

@{
    var rowNo = 1;
}

<!-- ===========================
 LOAD SERVER → LOCALSTORAGE
=========================== -->

<script>

    document.addEventListener(

    "DOMContentLoaded",

    function(){

    const denpyono =

    document.querySelector(

    '[name="Denpyono"]'

    )?.value;

    if(!denpyono) return;



    // =========================
    // CHECK FIRST TIME ONLY
    // =========================

    const existed =

    Object.keys(localStorage)

    .some(key =>

    key.startsWith(

    `PlannedTransactionDetail_${denpyono}_`

    )

    );

    // nếu đã có rồi → STOP

    if(existed){

    console.log("already synced");

    return;

    }



    // =========================
    // SAVE DB DATA
    // =========================
    serverDetails.forEach(item=>{

    const key =

    `PlannedTransactionDetail_${item.Denpyono}_${item.Gyono}`;

    localStorage.setItem(

    key,

    JSON.stringify(item)

    );

    });

    });

</script>




<!-- ===== 明細追加 ===== -->

<div class="row mb-3 align-items-center">

    <label class="col-2 col-form-label">

        （備考）

    </label>

    <div class="col text-end">

        <a class="btn btn-primary"
           asp-controller="PlannedTransactionDetail"
           asp-action="Index"
           asp-route-Denpyono="@Model.Denpyono"
           asp-route-Gyono="@Model.NextGyono">

            明細追加

        </a>

    </div>

</div>





<!-- ===========================
 DETAIL TABLE
=========================== -->

<table class="table align-middle">

    <thead>

        <tr>

            <th colspan="6"
                class="text-center">

                交通費

            </th>

        </tr>

        <tr>

            <th>行</th>

            <th>年月日</th>

            <th>出発地</th>

            <th>目的地</th>

            <th>経路</th>

            <th>金額</th>
        </tr>

    </thead>



    <tbody id="detailBody">

        @if (Model?.Results != null &&
                Model.Results.Any())
        {

            foreach (var item in Model.Results)
            {

                var detailUrl =

                Url.Action(

                "Index",

                "PlannedTransactionDetail",

                new
                {

                    Denpyono = item.Denpyono,

                    Gyono = item.Gyono,

                    Idodt =
                item.Idodt?.ToString("yyyy-MM-dd"),

                    ShuppatsuPlc =
                item.ShuppatsuPlc,

                    MokutekiPlc =
                item.MokutekiPlc,

                    Keiro =
                item.Keiro,

                    Kingaku =
                item.Kingaku,

                    isCreated = true,

                    isCheckedToDelete = false

                });

                <tr class="detail-row"
                    data-denpyono="@item.Denpyono"
                    data-gyono="@item.Gyono"
                    onclick="location.href='@detailUrl'">

                    <td>

                        @rowNo

                    </td>

                    <td>

                        @item.Idodt?.ToString("yyyy-MM-dd")

                    </td>

                    <td>

                        @item.ShuppatsuPlc

                    </td>

                    <td>

                        @item.MokutekiPlc

                    </td>

                    <td>

                        @item.Keiro

                    </td>

                    <td>

                        @(item.Kingaku?.ToString("N0"))

                    </td>

                </tr>

                rowNo++;

            }

        }
        else
        {

            <tr>

                <td colspan="6"
                    class="text-center text-muted py-4">

                    明細データがありません

                </td>

            </tr>

        }

    </tbody>




    <tfoot>

        <tr>

            <td colspan="4"></td>

            <td class="fw-bold">

                交通費計

            </td>

            <td id="totalKingaku"
                class="fw-bold">

                @(Model?.TotalKingaku?.ToString("N0"))

            </td>

        </tr>

    </tfoot>

</table>





<style>

    .detail-row {
        cursor: pointer;
    }

    .table tbody tr.deleted-row> td{
        background-color: darkgray !important;
        color: white !important;
    }

        .detail-row:hover {
            background-color: #f8f9fa;
        }

</style>