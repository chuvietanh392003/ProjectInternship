@if (TempData["Success"] != null)
{
    <script>

        alert('@Html.Raw(TempData["Success"])');

        Object.keys(localStorage)
        .forEach(key => {
            if (key.startsWith(
                "PlannedTransactionDetail_"))
            {
                localStorage.removeItem(key);
            }

        });

        window.location.href =
        '@Url.Action("Index", "PlannedTransaction")';

    </script>
}

