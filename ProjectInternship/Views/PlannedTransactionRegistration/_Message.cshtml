@if (TempData["Success"] != null)
{
    <script>

        alert('@TempData["Success"]');

        Object.keys(localStorage)
        .forEach(key => {

            if (key.startsWith(
                "PlannedTransactionDetail_"))
            {
                localStorage.removeItem(key);
            }

        });

        setTimeout(() => {

        window.location.href =
        '@Url.Action("Index", "PlannedTransaction")';

        },100);

    </script>
}