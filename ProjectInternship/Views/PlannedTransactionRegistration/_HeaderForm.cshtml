@model PlannedTransactionRegistrationVM

<!-- ===== 伝票番号 ===== -->

<div class="row mb-3 align-items-start">

    <label class="col-2">

        伝票番号

    </label>

    <div class="col-2 align-items-start">
        <input type="hidden" asp-for="Denpyono" />
        <input asp-for="Denpyono"
               readonly
               class=" @(Model.IsCreated == false ? "form-control bg-secondary text-secondary" : "form-control")"
               value= "@(Model.Denpyono?.ToString("0"))">
    </div>


    <div class="col-8 text-end align-items-start">

        <button type="submit"
                name="actionType"
                value="register"
                onclick="prepareResultsBeforeSubmit()"
                class="btn btn-primary me-2">

            登録

        </button>


        <button type="submit"
                name="actionType"
                value="delete"
                class="btn btn-danger me-2"
                @(Model.IsCreated ? "" : "disabled")
                onclick="return confirm('このレコードを削除しますか')">
            削除

        </button>


        <button type="submit"
                name="actionType"
                value="exit"
                onclick="@(Model.IsCreated ? ""  : "clearKeyStorage()") "
                class="btn btn-secondary">

            終了

        </button>

    </div>

</div>



<!-- ===== 伝票日付 ===== -->

<div class="row mb-3 align-items-start">

    <label class="col-2">

        伝票日付

    </label>

    <div class="col-2">

        <input asp-for="Denpyodt"
               type="date"
               readonly
               class=" @(Model.IsCreated == false ? "form-control bg-secondary text-secondary" : "form-control")" />
    </div>


    <label class="col-2 text-center">

        出納方法

    </label>

    <div class="col-2">

        <select asp-for="Suitokb"
                class="form-select">

            <option hidden value="">

                -- 選択 --

            </option>

            <option value="現金">

                現金

            </option>

            <option value="振込">

                振込

            </option>

        </select>

        <span asp-validation-for="Suitokb"
              class="text-danger"></span>

    </div>


    <label class="col-2 text-center">

        支払予定日

    </label>

    <div class="col-2">

        <input asp-for="Shiharaidt"
               type="date"
               class="form-control" />

        <span asp-validation-for="Shiharaidt"
              class="text-danger"></span>

    </div>

</div>



<!-- ===== 年度 ===== -->

<div class="row mb-3 align-items-start">

    <label class="col-2">

        年度

    </label>

    <div class="col-2">

        <select class="form-select" asp-for="Kaikeind">
            <option value="" selected hidden disabled>　xxxx年度</option>
            <option value="2025">-- 5去年 --</option>
            <option value="2026">-- 今年 --</option>
            <option value="2027">-- 5来年--</option>
        </select>

        <span asp-validation-for="Kaikeind"
              class="text-danger"></span>

    </div>

</div>



<!-- ===== 申請日 ===== -->

<div class="row mb-3 align-items-start">

    <label class="col-2">

        申請日

    </label>

    <div class="col-2">

        <input asp-for="Uketukedt"
               type="date"
               class="form-control" />

        <span asp-validation-for="Uketukedt"
              class="text-danger"></span>

    </div>

</div>



<!-- ===== 部門 ===== -->

<div class="row mb-3 align-items-start">

    <label class="col-2">

        起票部門

    </label>

    <div class="col-2">

        <input asp-for="BumoncdYkanr"
               class="form-control" />

        <span asp-validation-for="BumoncdYkanr"
              class="text-danger"></span>

    </div>

    <div class="col-3 text-start">

        <input asp-for="BumoncdName"
               readonly
               class="form-control bg-secondary text-white" />
    </div>

    <div class="col-2">

        <button type="button"
                id="openBumonModal"
                class="btn btn-primary">

            が

        </button>

    </div>

</div>



<!-- ===== 出張目的 ===== -->

<div class="row mb-3 align-items-start">

    <label class="col-2">

        出張目的

    </label>

    <div class="col-4">

<textarea asp-for="Biko"
          class="form-control">

</textarea>

        <span asp-validation-for="Biko"
              class="text-danger"></span>

    </div>

</div>