@*
-----------------------------------------------------------------------
File Name   : Department.cshtml
Screen Name : 部門一覧 (Department Selection)

Summary :
    This view displays the department search and selection screen.

    Users can:
        - Search departments by department code (部門コード)
          or department name (部門名).
        - View the list of departments in a table.
        - Select a department using a radio button.
        - Confirm the selection and return the department
          information to the parent screen.

Main Functions :
    1. Search departments using the search form.
    2. Display department list based on search results.
    3. Allow user to select one department from the table.
    4. Return selected department code and name to the main screen.

Notes :
    - This view is loaded inside a modal window.
    - Layout is disabled because it is used as a partial modal content.
-----------------------------------------------------------------------
*@
@model DepartmentVM
@{
    Layout = null;
}
<h2 class="text-center align-content-around mb-5">部門</h2>
<div class="container">
    <form asp-controller="Department" asp-action="Index" onsubmit="searchBumon(event)" method="get" id="bumonSearchForm">
        <div class="row mb-3 align-items-center">
            <div class="col-3">
                <label class="col-form-label">部門コード</label>
            </div>
            <div class="col-3">
                <input asp-for="BumonCode" class="form-control" name="BumonCode" />
            </div>
        </div>
        <div class="row mb-3 align-items-center">
            <div class="col-3">
                <label class="col-form-label">部門名</label>
            </div>
            <div class="col-6">
                <input asp-for="BumonName" class="form-control" name="BumonName" />
            </div>
        </div>
        <div class="row mb-3 align-items-center">
            <div class="col-3">
            </div>
            <div class="col-3">
                <button type="submit" class="btn btn-primary">検索</button>
            </div>
        </div>
    </form>
    
    <table class="table table-bordered table-hover table-striped align-middle">
        <thead class="table-success text-center">
            <tr>
                <th style="width: 80px;">選択</th>
                <th style="width: 150px;">部門コード</th>
                <th>部門名</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Results != null && Model.Results.Any())
            {
                foreach (var item in Model.Results)
                {
                    <tr onclick="selectRow(this)">
                        
                        <td class="text-center">
                            <input type="radio"
                                    class="btn btn-primary"
                                    value="@item.BumonCode"
                                    data-name="@item.BumonName"
                                    name="selectedBumon">
                        </td>
                        <td class="text-center">@item.BumonCode</td>
                        <td>@item.BumonName</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        データがありません。
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="row mb-3 align-items-center">
        <div class="col-3">
            <button type="button" class="btn btn-primary" onclick=  "selectBumon()">選択</button>
            <button type="button" onclick="closeModel()" class="btn btn-dark">戻る</button>
        </div>
    </div>
</div>