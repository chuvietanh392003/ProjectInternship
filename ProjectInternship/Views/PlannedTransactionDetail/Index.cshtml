@*
-----------------------------------------------------------------------
Screen Name : PlannedTransactionDetail (予定伝票明細)
Description :
    Screen used to create or update planned transaction detail.

    User can input the following information:
        ・Date (年月日)
        ・Departure place (出発地)
        ・Destination (目的地)
        ・Route (経路)
        ・Amount (金額)

    The screen also allows marking a record for deletion when editing.
-----------------------------------------------------------------------
*@
@model PlannedTransactionDetailVM

<h2 class="text-center align-content-around mb-5">予定伝票明細</h2>
<form action="/PlannedTransactionDetail/Index" method="post" id="mainForm">
	<div class="row mb-3 align-items-center">
		<div class="col-2">
			<label class="col-form-label">年月日</label>
		</div>
		<div class="col-2">
			<input class="form-control" type ="date" asp-for="Idodt" />
			<span asp-validation-for="Idodt" class="text-danger"></span>
		</div>
	</div>
	<div class="row mb-3 align-items-center">
		<div class="col-2">
			<label class="col-form-label">出発地</label>
		</div>
		<div class="col-2">
			<input class="form-control" asp-for="ShuppatsuPlc" />
			<span asp-validation-for="ShuppatsuPlc" class="text-danger"></span>
		</div>
	</div>
	<div class="row mb-3 align-items-center">
		<div class="col-2">
			<label class="col-form-label">目的地</label>
		</div>
		<div class="col-2">
			<input class="form-control" asp-for="MokutekiPlc" />
			<span asp-validation-for="MokutekiPlc" class="text-danger"></span>
		</div>
	</div>
	<div class="row mb-3 align-items-center">
		<div class="col-2">
			<label class="col-form-label">経路</label>
		</div>
		<div class="col-2">
			<input class="form-control" asp-for="Keiro" />
			<span asp-validation-for="Keiro" class="text-danger"></span>
		</div>
	</div>
	<div class="row mb-3 align-items-center">
		<div class="col-2">
			<label class="col-form-label" >金額</label>
		</div>
		<div class="col-2">
			<input class="form-control" asp-for="Kingaku" />
			<span asp-validation-for="Kingaku" class="text-danger"></span>
		</div>
	</div>
	<div class="row mb-3 align-items-center">
		<div class="col-2">
			<label class="col-form-label">削除</label>
		</div>
		<div class="col-2">
			<input asp-for="IsCheckedToDelete"
				   class="form-check-input"
				   type="checkbox"
				   disabled="@(Model.IsCreated != true)" />
			<input type="hidden" asp-for="Denpyono" />
			<input type="hidden" asp-for="Gyono" />
		</div>
		<div class="col-8 text-end">

			<button type="submit"
					@* onclick="submitValidForm()" *@
					class="btn btn-primary">
				登録
			</button>

			<button type="button"
					onclick="history.back()"
					class="btn btn-secondary">
				終了
			</button>
		</div>
	</div>
</form>
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
	<script src="~/js/planned-transaction-detail.js"></script>
}