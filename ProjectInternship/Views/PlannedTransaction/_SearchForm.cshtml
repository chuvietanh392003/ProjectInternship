@*
-----------------------------------------------------------------------
Summary :
    Search form for planned transactions.

    Users can search planned transaction records by:
        ・Fiscal year (年度)
        ・Transaction number range (伝票番号)
        ・Slip date range (伝票日付)
        ・Application date range (申請日)
        ・Payment method (出納方法)

    Functions :
        - Submit search conditions to PlannedTransaction/Index.
        - Navigate to PlannedTransactionRegistration screen for new record creation.
-----------------------------------------------------------------------
*@

@model PlannedTransactionSearchVM

<form asp-controller="PlannedTransaction"
      asp-action="Index"
      method="post">

    <div class="container">

        <div class="row mb-3">

            <label class="col-4 col-form-label">

                年度

            </label>

            <div class="col-3">
                <select class="form-select" asp-for="Kaikeind">
                    <option value="" selected hidden disabled>　xxxx年度</option>
                    <option value="2021">2021</option>
                    <option value="2022">2022</option>
                    <option value="2023">2023</option>
                    <option value="2024">2024</option>
                    <option value="2025">2025</option>
                    <option value="2026">2026</option>
                    <option value="2027">2027</option>
                    <option value="2028">2028</option>
                    <option value="2029">2029</option>
                    <option value="2030">2030</option>
                    <option value="2031">2031</option>
                </select>
            </div>

        </div>


        <div class="row mb-3">

            <label class="col-4 col-form-label">

                伝票番号

            </label>

            <div class="col-2">

                <input asp-for="DenpyonoFrom"
                       type="number"
                       class="form-control" />

            </div>

            -

            <div class="col-2">

                <input asp-for="DenpyonoTo"
                       type="number"
                       class="form-control" />

            </div>
            <div class="col-2">

                <span asp-validation-for="DenpyonoFrom"
                      class="text-danger"></span>
            </div>

        </div>


        <div class="row mb-3">

            <label class="col-4 col-form-label">

                伝票日付

            </label>

            <div class="col-2">

                <input asp-for="DenpyodtFrom"
                       type="date"
                       class="form-control" />

            </div>

            -

            <div class="col-2">

                <input asp-for="DenpyodtTo"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-2">

                <span asp-validation-for="DenpyodtFrom"
                      class="text-danger"></span>
            </div>

        </div>


        <div class="row mb-3">

            <label class="col-4 col-form-label">

                申請日

            </label>

            <div class="col-2">

                <input asp-for="UketukedtFrom"
                       type="date"
                       class="form-control" />

            </div>

            -

            <div class="col-2">

                <input asp-for="UketukedtTo"
                       type="date"
                       class="form-control" />
            </div>
            <div class="col-2">

                <span asp-validation-for="UketukedtFrom"
                      class="text-danger"></span>
            </div>

           

        </div>


        <div class="row mb-3 align-items-center">

            <label class="col-4 col-form-label">

                出納方法

            </label>

            <div class="col-2">

                <div class="form-check mt-2">

                    <input asp-for="Suitofuri"
                           class="form-check-input"
                           type="checkbox"
                           id="suitofuri" />

                    <label class="form-check-label"
                           for="suitofuri">

                        振込

                    </label>

                </div>

            </div>


            <div class="col-2">

                <div class="form-check mt-2">

                    <input asp-for="Genkin"
                           class="form-check-input"
                           type="checkbox"
                           id="genkin" />

                    <label class="form-check-label"
                           for="genkin">

                        現金

                    </label>

                </div>

            </div>
            <div class="col-4 text-end pe-5">
                <button type="submit" 
                        class="btn btn-primary">

                    探索

                </button>
                <a asp-controller="PlannedTransactionRegistration"
                   asp-action="Index"
                   class="btn btn-primary">

                    登録

                </a>

            </div>

        </div>

    </div>

</form>