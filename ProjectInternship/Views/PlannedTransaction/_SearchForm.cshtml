@model PlannedTransactionSearchVM

<form asp-controller="PlannedTransaction"
      asp-action="Index"
      method="post">

    <div class="container">

        <div class="row mb-3">

            <label class="col-4 col-form-label">

                年度

            </label>

            <div class="col-3">
                <select class="form-select" asp-for="Kaikeind">
                    <option value="" selected hidden disabled>　xxxx年度</option>
                    <option value="2025">-- 5去年 --</option>
                    <option value="2026">-- 今年 --</option>
                    <option value="2027">-- 5来年--</option>
                </select>
            </div>

        </div>


        <div class="row mb-3">

            <label class="col-4 col-form-label">

                伝票番号

            </label>

            <div class="col-2">

                <input asp-for="DenpyonoFrom"
                       type="number"
                       class="form-control" />

            </div>

            -

            <div class="col-2">

                <input asp-for="DenpyonoTo"
                       type="number"
                       class="form-control" />

            </div>
            <div class="col-2">

                <span asp-validation-for="DenpyonoFrom"
                      class="text-danger"></span>
            </div>

        </div>


        <div class="row mb-3">

            <label class="col-4 col-form-label">

                伝票日付

            </label>

            <div class="col-2">

                <input asp-for="DenpyodtFrom"
                       type="date"
                       class="form-control" />

            </div>

            -

            <div class="col-2">

                <input asp-for="DenpyodtTo"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-2">

                <span asp-validation-for="DenpyodtFrom"
                      class="text-danger"></span>
            </div>

        </div>


        <div class="row mb-3">

            <label class="col-4 col-form-label">

                申請日

            </label>

            <div class="col-2">

                <input asp-for="UketukedtFrom"
                       type="date"
                       class="form-control" />

            </div>

            -

            <div class="col-2">

                <input asp-for="UketukedtTo"
                       type="date"
                       class="form-control" />
            </div>
            <div class="col-2">

                <span asp-validation-for="UketukedtFrom"
                      class="text-danger"></span>
            </div>

           

        </div>


        <div class="row mb-3 align-items-center">

            <label class="col-4 col-form-label">

                出納方法

            </label>

            <div class="col-2">

                <div class="form-check mt-2">

                    <input asp-for="Suitofuri"
                           class="form-check-input"
                           type="checkbox"
                           id="suitofuri" />

                    <label class="form-check-label"
                           for="suitofuri">

                        振込

                    </label>

                </div>

            </div>


            <div class="col-2">

                <div class="form-check mt-2">

                    <input asp-for="Genkin"
                           class="form-check-input"
                           type="checkbox"
                           id="genkin" />

                    <label class="form-check-label"
                           for="genkin">

                        現金

                    </label>

                </div>

            </div>
            <div class="col-4 text-end pe-5">
                <button type="submit" 
                        class="btn btn-primary">

                    探索

                </button>
                <a asp-controller="PlannedTransactionRegistration"
                   asp-action="Index"
                   class="btn btn-primary">

                    登録

                </a>

            </div>

        </div>

    </div>

</form>