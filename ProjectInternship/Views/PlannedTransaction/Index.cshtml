@*
-----------------------------------------------------------------------
Summary :
    Main screen for Planned Transaction List (予定伝票一覧).

    This view composes the search screen by combining:
        ・Search condition form
        ・Search result table

    Functions :
        1. Display search conditions for planned transactions.
        2. Show search results in a table.
        3. Load JavaScript for search handling and validation.
-----------------------------------------------------------------------
*@
@model PlannedTransactionSearchVM

@{
    ViewData["Title"] = "予定伝票一覧";
}

<h2 class="text-center mb-5">予定伝票一覧</h2>

<partial name="_SearchForm" model="Model" />

<div id="resultContainer">
    <partial name="_ResultTable" model="Model" />
</div>

@section Scripts {

    <script src="~/js/planned-transaction-search.js"></script>

    <partial name="_ValidationScriptsPartial" />

}